# ─────────────────────────────────────────────────────────────
# Naghmat e Muhaamid — environment variables
# Copy to `.env.local` and fill in. ALL of these are server-only:
# none are prefixed NEXT_PUBLIC_, so none ever reach the browser.
# ─────────────────────────────────────────────────────────────

# Public read path. Point this at a Neon role with SELECT-only grants
# on `categories` and `kalam`. Used by every public page.
DATABASE_URL="postgresql://readonly_user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Privileged write path. Used ONLY by /admin server actions and by
# the migrate/seed scripts. Never imported from a client component.
DATABASE_URL_ADMIN="postgresql://owner:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin login password (single-admin app).
ADMIN_PASSWORD="change-me-to-something-long"

# Secret used to HMAC-sign the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-64-hex-chars"

# Canonical origin, used for OpenGraph URLs and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
